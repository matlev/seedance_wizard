  "frequencyMeasurement": {
    "window": "rectangular over qualityRegion",
    "dcRemoval": "subtract per-channel arithmetic mean over qualityRegion",
    "sampleIndex": "absolute content-normalized sample index",
    "projection": "For frequency f: re=sum(y[n]*cos(2*pi*f*n/48000)); im=-sum(y[n]*sin(2*pi*f*n/48000)); power=(re^2+im^2)/N^2.",
    "expectedToneRule": "For every descriptor-declared expected frequency, compute sqrt(output tone power / independently generated reference tone power) and require the resulting amplitude ratio to remain within 0.90 through 1.10.",
    "forbiddenToneRule": "Apply the expected/forbidden ratio only when the reference descriptor declares a forbidden tone.",
    "identityControlMinimumObservedExpectedToForbiddenRatio": 4567.973443426002,
    "approvedThresholdToIdentityFloorMargin": "100:1 is more than 45 times below the measured identity-control floor.",
    "loopBoundaryLeakageIsIncluded": true
  },
  "metricDefinitions": {
    "normalizedCrossCorrelation": "sum((x-mean(x))*(y-mean(y))) / sqrt(sum((x-mean(x))^2)*sum((y-mean(y))^2))",
    "normalizedRmsError": "rms(y-x) / rms(x)",
    "snrDb": "10*log10(sum((x-mean(x))^2)/sum((y-x)^2))",
    "rmsRatio": "rms(y-mean(y))/rms(x-mean(x))",
    "expectedToneOutputToReferenceAmplitudeRatio": "sqrt(outputTonePower/referenceTonePower), where each tone power is (re^2+im^2)/N^2 over the same zero-lag quality region",
    "dcOffsetFullScale": "abs(mean(y))/32768"
  },
