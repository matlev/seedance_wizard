    "stagingRoot": "repository sibling ReelForge.Gate0Staging/{proofRunId}",
    "stagingPersistence": "survives failures; no automatic deletion",
    "groupIdFormat": "Gate0.G05.Calibration.{UTC yyyyMMddTHHmmssfffZ}.{8 uppercase hex characters}",
    "destinationNameFormat": "proofs/g05-calibration-{UTC yyyyMMddTHHmmssfffZ}-{8 lowercase hex characters}",
    "retainEveryAttempt": true,
    "stagingCleanupEligibility": "only after append and full retained-corpus revalidation; explicit cleanup action required",
    "reportOnlyAfterAppendAndRevalidation": true,
    "copyStatus": "one-local-copy-only",
