{
  "schemaVersion": 1,
  "contractId": "Gate0.G05.Calibration.V1",
  "status": "authorized-bounded-calibration-design",
  "purpose": "Short, sequential calibration of exact P2 delivery routes on the owner reference machine. Results are exploratory evidence and cannot establish final thresholds, a shipping runtime, a public hardware minimum, distribution approval, or portable UI behavior.",
  "profileId": "P2.BtbnLgplShared.WindowsX64.20260820",
  "referenceMachine": {
    "cpu": "AMD Ryzen 7 3700X",
    "memoryGiB": 32,
    "gpu": "NVIDIA GeForce RTX 3070 Ti",
    "gpuMemoryGiB": 8,
    "classification": "initial-reference-profile-not-public-minimum"
  },
  "source": {
    "fixture": "F1",
    "visualTruth": "repeat the complete authored F1 visual sequence without gaps",
    "audioTruth": "repeat the complete authored F1 stereo 440 Hz left and 880 Hz right sequence without gaps",
    "inputConstruction": [
      {
        "inputIndex": 0,
        "sourcePrimitive": "retained F1 PPM sequence",
        "repeatWithoutGaps": true,
        "inputLoopArguments": ["-stream_loop", "-1"],
        "demuxer": "image2",
        "decoder": "ppm",
        "frameRate": "25/1",
        "streamSelection": "0:v:0"
      },
      {
        "inputIndex": 1,
        "sourcePrimitive": "retained F1 PCM s16le stereo bytes",
        "repeatWithoutGaps": true,
        "inputLoopArguments": ["-stream_loop", "-1"],
        "demuxer": "s16le",
        "decoder": "pcm_s16le",
        "sampleRate": 48000,
        "channels": 2,
        "streamSelection": "1:a:0"
      }
    ],
    "videoFilters": ["scale", "format", "setpts"],
    "audioFilters": ["aresample", "aformat", "asetpts"],
    "videoFilterTemplate": "scale={width}:{height}:flags=bilinear,format=yuv420p,setpts=PTS-STARTPTS",
    "audioFilter": "aresample=48000,aformat=sample_fmts=s16:sample_rates=48000:channel_layouts=stereo,asetpts=PTS-STARTPTS",
    "maps": ["0:v:0", "1:a:0"],
    "outputDurationArguments": ["-t", "{durationSeconds}"],
    "durationPlacement": "output option after both inputs and before the output path"
  },
  "calibration": {
    "resolutions": [
      { "id": "720p", "width": 1280, "height": 720 },
      { "id": "1080p", "width": 1920, "height": 1080 }
    ],
    "frameRate": "25/1",
    "durationSeconds": 8,
    "warmupRepetitions": 1,
    "measuredRepetitions": 2,
    "concurrentProcessCount": 1,
    "threadPolicies": [
      { "id": "auto", "codecThreads": 0, "filterThreads": "omit-use-runtime-default", "filterComplexThreads": "not-applicable-no-complex-filtergraph", "meaning": "request codec automatic selection and retain the filter runtime default; record observations without claiming a hard cap" },
      { "id": "one", "codecThreads": 1, "filterThreads": 1, "filterComplexThreads": "not-applicable-no-complex-filtergraph" },
      { "id": "half-logical", "codecThreads": "ceil(observedLogicalProcessors/2)", "filterThreads": "ceil(observedLogicalProcessors/2)", "filterComplexThreads": "not-applicable-no-complex-filtergraph" },
      { "id": "full-logical", "codecThreads": "observedLogicalProcessors", "filterThreads": "observedLogicalProcessors", "filterComplexThreads": "not-applicable-no-complex-filtergraph" }
    ],
    "routeIds": [
      "Video.Export.Compatibility.Mp4H264Aac.P2OpenH264",
      "Video.Export.Open.WebmVp9Opus"
    ],
    "statisticsClassification": "exploratory-not-acceptance",
    "maximumCompletedOutputDurationSeconds": 8,
    "prohibitedWithoutNextOwnerCheckpoint": [
      "process concurrency above one",
      "typical or stress shape execution",
      "60-120 minute execution",
      "claims of p50 or p95 acceptance",
      "claims of actual WPF dispatcher latency from a headless heartbeat"
    ]
  },
  "routes": [
    {
      "id": "Video.Export.Compatibility.Mp4H264Aac.P2OpenH264",
      "inputDemuxers": ["image2", "s16le"],
      "inputDecoders": ["ppm", "pcm_s16le"],
      "streamMaps": ["0:v:0", "1:a:0"],
      "filters": ["scale", "format", "setpts", "aresample", "aformat", "asetpts"],
      "container": "mp4",
      "videoEncoder": "libopenh264",
      "audioEncoder": "aac",
      "muxer": "mp4",
      "outputDemuxer": "mov,mp4,m4a,3gp,3g2,mj2",
      "outputDecoders": ["h264", "aac"],
      "videoOptions": ["-profile:v", "constrained_baseline", "-rc_mode", "bitrate", "-b:v", "2M", "-g", "25", "-allow_skip_frames", "false"],
      "audioOptions": ["-profile:a", "aac_low", "-b:a", "192k"],
      "muxerOptions": ["-movflags", "+faststart"],
      "openFinding": "OpenH264 no-frame-skip and rate-control warning must remain in quality-policy evidence."
    },
    {
      "id": "Video.Export.Open.WebmVp9Opus",
      "inputDemuxers": ["image2", "s16le"],
      "inputDecoders": ["ppm", "pcm_s16le"],
      "streamMaps": ["0:v:0", "1:a:0"],
      "filters": ["scale", "format", "setpts", "aresample", "aformat", "asetpts"],
      "container": "webm",
      "videoEncoder": "libvpx-vp9",
      "audioEncoder": "libopus",
      "muxer": "webm",
      "outputDemuxer": "matroska,webm",
      "outputDecoders": ["vp9", "opus"],
      "videoOptions": ["-b:v", "0", "-crf", "32", "-g", "25", "-deadline", "good", "-cpu-used", "2", "-row-mt", "0", "-tile-columns", "0", "-tile-rows", "0"],
      "audioOptions": ["-b:a", "128k", "-vbr", "off", "-compression_level", "10", "-frame_duration", "20"],
      "threadNote": "The matrix-selected codec thread value replaces the prior G0.4 fixed value of one; row-mt and tile settings remain explicit."
    }
  ],
  "measurement": {
    "progress": { "source": "ffmpeg -progress", "statsPeriodSeconds": 0.5, "humanStatsAreDiagnosticOnly": true },
    "sampleIntervalMilliseconds": 500,
    "wallClock": "monotonic-host-clock",
    "rawSampleFields": [
      "monotonicTimestampMilliseconds",
      "processId",
      "processStartIdentity",
      "totalProcessorTimeMilliseconds",
      "workingSetBytes",
      "privateMemoryBytes",
      "readOperationCount",
      "writeOperationCount",
      "otherOperationCount",
      "readTransferBytes",
      "writeTransferBytes",
      "otherTransferBytes",
      "observedProcessCount"
    ],
    "summaryFields": [
      "exitCode",
      "wallClockMilliseconds",
      "observedLogicalProcessorCount",
      "meanNormalizedCpuPercent",
      "peakNormalizedCpuPercent",
      "peakWorkingSetBytes",
      "peakPrivateMemoryBytes",
      "readOperationDelta",
      "writeOperationDelta",
      "otherOperationDelta",
      "readTransferByteDelta",
      "writeTransferByteDelta",
      "otherTransferByteDelta",
      "meanReadBytesPerSecond",
      "peakIntervalReadBytesPerSecond",
      "meanWriteBytesPerSecond",
      "peakIntervalWriteBytesPerSecond"
    ],
    "cpuNormalizationFormula": "100 * processCpuTimeDeltaMilliseconds / (sampleWallTimeDeltaMilliseconds * observedLogicalProcessorCount)",
    "processAggregation": "Root FFmpeg process is authoritative. Record discovered descendants separately; any process-tree aggregate must state exact membership and sampling limitations.",
    "gpuDispositionValues": ["not-applicable", "unavailable", "measured"],
    "requiredOutputOracles": [
      "artifactSha256",
      "artifactBytes",
      "container",
      "explicitStreams",
      "codecIdentity",
      "dimensions",
      "frameRate",
      "durationAndTimestampEvidence",
      "strictCompleteDecode",
      "allFrameIdentityCycle"
    ]
  },
  "outputOracle": {
    "comparisonTimeBase": "1/1000",
    "expectedFrameCount": 200,
    "expectedFrameRate": "25/1",
    "expectedFirstFrameTimestamp": 0,
    "expectedFinalFrameTimestamp": 7960,
    "expectedFrameIdentityCycle": ["f1-pattern-000", "f1-pattern-001", "f1-pattern-002"],
    "validateEveryDecodedFrameAgainstCycle": true,
    "maximumMeanAbsoluteErrorPerFrame": 18,
    "expectedAudioSamplesPerChannel": 384000,
    "maximumAbsoluteAudioSampleDelta": 3072,
    "expectedAudioSampleRate": 48000,
    "expectedAudioChannels": 2,
    "leftToneHz": 440,
    "rightToneHz": 880,
    "audioToleranceSource": "g0.4-delivery-proof-contract.json compressed audio tolerances"
  },
  "cancellation": {
    "probesPerRoute": 1,
    "resolution": { "width": 1920, "height": 1080 },
    "targetOutputDurationSeconds": 120,
    "requestAfterConfirmedProgressMilliseconds": 500,
    "activeProgressDeadlineSeconds": 5,
    "hardWallClockLimitSeconds": 15,
    "maximumOutputBytes": 536870912,
    "outputSizeMonitoring": "Poll the output at every 500 ms process-sample interval. At or above the ceiling, stop the process tree immediately and record bounded-resource-limit; this is not a cancellation pass.",
    "recordPaths": ["clean-exit", "graceful-signal", "timeout-escalation", "forced-process-tree-termination"],
    "alreadyCompletedDisposition": "not-exercised",
    "neverActiveDisposition": "blocked-startup",
    "forcedTerminationIsNotCleanCancellation": true,
    "partialOutputMustBeValidatedOrRemoved": true
  },
  "retention": {
