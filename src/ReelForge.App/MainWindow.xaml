<Window x:Class="ReelForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReelForge.App"
        xmlns:jobs="clr-namespace:ReelForge.App.Views.Jobs"
        xmlns:generation="clr-namespace:ReelForge.App.Views.Generation"
        xmlns:editing="clr-namespace:ReelForge.App.Views.Editing"
        xmlns:inspector="clr-namespace:ReelForge.App.Views.Inspector"
        xmlns:mediaPreview="clr-namespace:ReelForge.App.Views.MediaPreview"
        xmlns:projectMedia="clr-namespace:ReelForge.App.Views.ProjectMedia"
        Title="ReelForge" Height="900" Width="1440"
        MinHeight="680" MinWidth="1080"
        AllowDrop="True"
        PreviewDragEnter="MainWindow_PreviewDragEnter"
        PreviewDragOver="MainWindow_PreviewDragOver"
        PreviewDragLeave="MainWindow_PreviewDragLeave"
        PreviewDrop="MainWindow_PreviewDrop"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="RightPanelTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,0,0,2"
                                CornerRadius="4,4,0,0"
                                Margin="0,0,3,0"
                                Padding="13,9,13,7">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#222633" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#292D3A" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RightPanelTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource RightPanelTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,-1"
                                      KeyboardNavigation.TabIndex="1" Panel.ZIndex="1" />
                            <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceModeButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeBorder" Background="#1C202B" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="18,8" Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#292D3A" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#A89BFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="ApplicationContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,5">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <jobs:GenerationJobsChrome x:Name="JobsChromeControl"
                                               OpenRequested="JobsChromeControl_OpenRequested" />
                    <TextBlock x:Name="ProjectTitleText" Text="No project open" Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="12,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="REELFORGE" Style="{StaticResource ApplicationTextBlockStyle}" FontSize="16" VerticalAlignment="Center" Margin="4,0,18,0" />
                    <Button x:Name="NewProjectButton" Content="New project" Click="NewProject_Click" />
                    <Button x:Name="OpenProjectButton" Content="Open" Click="OpenProject_Click" />
                    <Button x:Name="ImportAssetsButton" Content="Import assets" Click="ImportAssets_Click" />
                    <Button x:Name="SettingsButton" Content="Settings" Click="Settings_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton x:Name="GenerateWorkspaceButton" Content="Generate" GroupName="Workspace"
                                 Style="{StaticResource WorkspaceModeButtonStyle}" IsChecked="True"
                                 Checked="WorkspaceMode_Checked" />
                    <RadioButton x:Name="EditWorkspaceButton" Content="Edit" GroupName="Workspace"
                                 Style="{StaticResource WorkspaceModeButtonStyle}"
                                 Checked="WorkspaceMode_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="210" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="370" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="ProjectMediaRow" Height="2*" MinHeight="80" />
                        <RowDefinition x:Name="GenerationSplitterRow" Height="5" />
                        <RowDefinition x:Name="GenerationHistoryRow" Height="*" MinHeight="80" />
                    </Grid.RowDefinitions>
                    <projectMedia:ProjectMediaPanel x:Name="ProjectMediaPanelControl" Grid.Row="0"
                                                    SelectedItemChanged="ProjectMediaPanel_SelectedItemChanged"
                                                    ActionRequested="ProjectMediaPanel_ActionRequested"
                                                    DragCompleted="ProjectMediaPanel_DragCompleted" />
                    <GridSplitter x:Name="GenerationPanelSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
                    <generation:GenerationHistoryPanel x:Name="GenerationHistoryPanelControl" Grid.Row="2"
                                                       GenerationSelected="GenerationHistoryPanel_GenerationSelected" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2" Background="#0B0D12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="280" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="330" MinHeight="220" />
                </Grid.RowDefinitions>

                <mediaPreview:MediaPreviewPanel x:Name="MediaPreviewPanelControl" Grid.Row="0"
                                                VideoReady="MediaPreview_VideoReady"
                                                PlaybackEnded="MediaPreview_PlaybackEnded"
                                                AuditionAudioFailed="CompositionAuditionAudio_MediaFailed"
                                                PlaybackRequested="Playback_Click"
                                                PreviousFrameRequested="PreviousFrame_Click"
                                                NextFrameRequested="NextFrame_Click"
                                                ScrubPositionChanged="MediaPreview_ScrubPositionChanged"
                                                ScrubCompleted="MediaPreview_ScrubCompleted"
                                                PositionTick="MediaPreview_PositionTick" />

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" />

                <Border x:Name="GenerateLowerWorkspace" Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                    <StackPanel x:Name="MediaPreparationHome" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <TextBlock Text="MEDIA PREPARATION" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="MediaPreparationSelectionText" Text="Select a video in Project Media"
                                   Style="{StaticResource ApplicationTextBlockStyle}" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,13,0,6" />
                        <TextBlock Text="Choose an operation when you want ReelForge to perform precise media work. Ordinary preview does not index or extract frames."
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button x:Name="SelectFrameButton" Content="Select Frame" Click="SelectFrame_Click" IsEnabled="False"
                                    ToolTip="Inspect exact decoded frames around the current playhead" />
                            <Button x:Name="MakeClipButton" Content="Make Clip" Click="MakeClip_Click" IsEnabled="False"
                                    ToolTip="Create a non-destructive Saved Clip using exact boundaries" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer x:Name="PrecisionFramePanel" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                    <Grid Margin="14,14,6,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="100" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="← Media preparation" Click="ExitFrameSelection_Click" Margin="0,0,10,0" />
                            <TextBlock x:Name="PrecisionOperationTitle" Text="SELECT FRAME" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="FrameWorkspaceStatusText" Text="Select a physical video" HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </DockPanel>
                        <DockPanel Grid.Row="1" Margin="0,8,0,6">
                            <WrapPanel x:Name="FrameSelectionActions">
                                <Button Content="First frame" Click="SelectFirstFrame_Click" Margin="0,0,6,0" />
                                <Button Content="Last frame" Click="SelectLastFrame_Click" Margin="0,0,6,0" />
                                <Button Content="Save selected frame" Click="SaveSelectedFrame_Click"
                                        Background="{StaticResource AccentBrush}" Foreground="White" />
                            </WrapPanel>
                            <WrapPanel x:Name="ClipSelectionActions" Visibility="Collapsed">
                                <Button Content="Start at beginning" Click="UseSourceStart_Click" Margin="0,0,6,0" />
                                <Button Content="Set start here" Click="SetClipStart_Click" Margin="0,0,6,0" />
                                <Button Content="Set end here" Click="SetClipEnd_Click" Margin="0,0,6,0" />
                                <Button Content="End at video end" Click="UseSourceEnd_Click" />
                            </WrapPanel>
                        </DockPanel>
                        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="#11141B">
                            <Grid>
                                <TextBlock x:Name="ContactFramesEmptyText" Text="Select a video to browse exact decoded frames."
                                           Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ListBox x:Name="ContactFramesList" SelectionChanged="ContactFramesList_SelectionChanged"
                                         PreviewKeyDown="ContactFramesList_PreviewKeyDown"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         Background="Transparent" BorderThickness="0" Padding="4">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="112" Margin="2">
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#050609" Height="62">
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                </Border>
                                                <TextBlock Text="{Binding TimestampText}" FontSize="10" TextAlignment="Center"
                                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="SavedFramesHeading" Grid.Row="3" Text="SAVED FRAMES" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,5" />
                        <Grid x:Name="SavedFramesWorkspace" Grid.Row="4" MinHeight="140">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="#11141B">
                                <Grid>
                                    <TextBlock x:Name="SavedFramesEmptyText" Text="No Saved Frames yet."
                                               Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <ListBox x:Name="SavedFramesList" SelectionChanged="SavedFramesList_SelectionChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             Background="Transparent" BorderThickness="0" Padding="4">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="126" Margin="2">
                                                    <Border BorderBrush="#8775FF" BorderThickness="2" Background="#050609" Height="66">
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayLabel}" Style="{StaticResource ApplicationTextBlockStyle}"
                                                               TextTrimming="CharacterEllipsis" Margin="1,3,1,0" />
                                                    <TextBlock Text="{Binding TimestampText}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Label" Style="{StaticResource ApplicationTextBlockStyle}" />
                                <TextBox x:Name="SavedFrameLabelTextBox" Margin="0,3,0,6" IsEnabled="False" />
                                <TextBlock Text="Notes" Style="{StaticResource ApplicationTextBlockStyle}" />
                                <TextBox x:Name="SavedFrameNotesTextBox" Margin="0,3,0,6" Height="34" TextWrapping="Wrap"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" IsEnabled="False" />
                                <WrapPanel>
                                    <Button x:Name="UpdateSavedFrameButton" Content="Update" Click="UpdateSavedFrame_Click" IsEnabled="False" Margin="0,0,5,0" />
                                    <Button x:Name="JumpToSavedFrameButton" Content="Jump to frame" Click="JumpToSavedFrame_Click" IsEnabled="False" Margin="0,0,5,0" />
                                    <Button x:Name="RemoveSavedFrameButton" Content="Remove" Click="RemoveSavedFrame_Click"
                                            Style="{StaticResource DangerButtonStyle}" IsEnabled="False" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                        <Border x:Name="ClipEditorWorkspace" Grid.Row="3" Grid.RowSpan="2" Visibility="Collapsed"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                Background="#11141B" Margin="0,8,0,0" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Clip name" Style="{StaticResource ApplicationTextBlockStyle}" />
                                    <TextBox x:Name="ClipNameTextBox" Margin="0,4,12,8" />
                                    <TextBlock x:Name="ClipBoundarySummaryText" Text="Start: video beginning&#x0a;End: video end"
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="Choose an exact frame above, then set it as the start or end. These boundaries stay out of Saved Frames."
                                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,7,12,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Save Clip" Click="SaveClip_Click"
                                        Background="{StaticResource AccentBrush}" Foreground="White"
                                        VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                    </Grid>
                </Border>
                <Border x:Name="EditLowerWorkspace" Grid.Row="2" Visibility="Collapsed"
                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="18">
                        <StackPanel x:Name="EditEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                            <TextBlock Text="WORKING COMPOSITION" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="No composition yet." Style="{StaticResource ApplicationTextBlockStyle}"
                                       FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,7" />
                            <TextBlock Text="Choose a starting video or Saved Clip from Project Media. The editor will build a logical composition without copying or destructively changing the source."
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                            <Button x:Name="StartEditButton" Content="Start Edit" Click="StartEdit_Click" IsEnabled="False"
                                    HorizontalAlignment="Center" Margin="0,16,0,0"
                                    ToolTip="Select a video or Saved Clip in Project Media first" />
                        </StackPanel>
                        <Grid x:Name="WorkingCompositionState" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="2,0,2,10">
                                <Button x:Name="PreviewCompositionButton" DockPanel.Dock="Right"
                                        Content="Preview composition" Click="PreviewComposition_Click"
                                        Background="{StaticResource AccentBrush}" Foreground="White"
                                        ToolTip="Render or reuse a cached preview of the committed composition" />
                                <Button x:Name="ExportCompositionButton" DockPanel.Dock="Right"
                                        Content="Export…" Click="ExportComposition_Click"
                                        ToolTip="Write this committed composition to a durable MP4 outside Project Media" />
                                <Button x:Name="CancelCompositionRenderButton" DockPanel.Dock="Right"
                                        Content="Cancel render" Click="CancelCompositionRender_Click"
                                        Style="{StaticResource DangerButtonStyle}" Visibility="Collapsed"
                                        ToolTip="Stop the current composition preview or export render" />
                                <StackPanel x:Name="CompositionRenderIndicator" DockPanel.Dock="Right"
                                            Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="0,0,10,0" Visibility="Collapsed">
                                    <ProgressBar Width="72" Height="6" IsIndeterminate="True"
                                                 VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock x:Name="CompositionRenderStatusText"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="WORKING COMPOSITION" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="WorkingCompositionNameText" Text="Working Composition"
                                               Style="{StaticResource ApplicationTextBlockStyle}" FontSize="18" FontWeight="SemiBold"
                                               Margin="0,5,0,2" />
                                    <TextBlock x:Name="WorkingCompositionSummaryText" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </DockPanel>
                            <Border x:Name="CompositionTimelineBorder" Grid.Row="1" MinHeight="168" Margin="0,0,0,8" Padding="8,6,8,4"
                                    Background="#10131A" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4" AllowDrop="True"
                                    PreviewDragEnter="CompositionTimeline_PreviewDragEnter"
                                    PreviewDragOver="CompositionTimeline_PreviewDragOver"
                                    PreviewDragLeave="CompositionTimeline_PreviewDragLeave"
                                    PreviewDrop="CompositionTimeline_PreviewDrop">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="2,0,2,5">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock Text="Zoom" Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <Slider x:Name="CompositionTimelineZoomSlider" Width="92"
                                                    Minimum="1" Maximum="8" Value="1"
                                                    TickFrequency="0.25" IsSnapToTickEnabled="True"
                                                    SmallChange="0.25" LargeChange="1"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="CompositionTimelineZoomSlider_ValueChanged"
                                                    ToolTip="Zoom the timeline horizontally without changing the composition" />
                                            <TextBlock x:Name="CompositionTimelineZoomText" Text="100%" Width="40"
                                                       Foreground="{StaticResource TextBrush}" FontSize="10"
                                                       TextAlignment="Right" VerticalAlignment="Center" />
                                            <Button Content="Reset" Padding="6,1" Margin="6,0,12,0"
                                                    Click="CompositionTimelineReset_Click"
                                                    ToolTip="Reset the timeline to its default scale" />
                                            <TextBlock x:Name="CompositionTimelineDurationText"
                                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="TIMELINE" Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <CheckBox x:Name="CompositionTimelineAutoScrollCheckBox"
                                                      Content="Auto-scroll during playback" IsChecked="True"
                                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                                      Foreground="{StaticResource TextBrush}"
                                                      ToolTip="Keep the composition playhead visible while playback advances. This choice is not saved." />
                                        </StackPanel>
                                    </DockPanel>
                                    <ScrollViewer x:Name="CompositionTimelineScrollViewer" Grid.Row="1"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  ScrollChanged="CompositionTimelineScrollViewer_ScrollChanged"
                                                  SizeChanged="CompositionTimelineScrollViewer_SizeChanged">
                                        <Canvas x:Name="CompositionTimelineCanvas" Height="124"
                                                Background="#0B0D12" ClipToBounds="True"
                                                PreviewMouseLeftButtonDown="CompositionTimelineCanvas_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="CompositionTimelineCanvas_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="CompositionTimelineCanvas_PreviewMouseLeftButtonUp"
                                                LostMouseCapture="CompositionTimelineCanvas_LostMouseCapture" />
                                    </ScrollViewer>
                                    <Canvas x:Name="CompositionTimelineDropHint" Grid.Row="1" Visibility="Hidden"
                                            IsHitTestVisible="False" ClipToBounds="True">
                                        <Border x:Name="CompositionTimelineDropMarker" Width="3" Height="67"
                                                Panel.ZIndex="10" Background="#FF4D5D" CornerRadius="2">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#FF2738" BlurRadius="7"
                                                                  ShadowDepth="0" Opacity="0.9" />
                                            </Border.Effect>
                                        </Border>
                                        <Border x:Name="CompositionTimelineDropToken" Width="96" Height="36"
                                                Panel.ZIndex="5"
                                                Background="#E83E3669" BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="2" CornerRadius="4" Padding="6,3">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="+" DockPanel.Dock="Left" Margin="0,0,5,0"
                                                           Foreground="White" FontSize="17" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock x:Name="CompositionTimelineDropHintText" Foreground="White"
                                                           FontWeight="SemiBold" FontSize="10"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </Canvas>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" />

            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                <TabControl x:Name="RightPanelTabs" Margin="8" Style="{StaticResource RightPanelTabControlStyle}">
                    <TabItem x:Name="InspectorTab" Header="Inspector">
                        <inspector:InspectorPanel x:Name="InspectorPanelControl" />
                    </TabItem>
                    <TabItem x:Name="GenerateTab" Header="Generate">
                        <generation:GenerationPanel x:Name="GenerationPanelControl"
                                                    ProviderChanged="GenerationPanel_ProviderChanged"
                                                    DraftChanged="GenerationPanel_DraftChanged"
                                                    ExpandPromptRequested="GenerationPanel_ExpandPromptRequested"
                                                    ReferenceSelected="GenerationPanel_ReferenceSelected"
                                                    NewRootRequested="GenerationPanel_NewRootRequested"
                                                    DerivedDraftRequested="GenerationPanel_DerivedDraftRequested"
                                                    SubmitRequested="GenerationPanel_SubmitRequested" />
                    </TabItem>
                    <TabItem x:Name="EditToolsTab" Header="Edit Tools" Visibility="Collapsed">
                        <editing:EditToolsPanel x:Name="EditToolsPanelControl"
                                                SegmentAudioChanged="EditToolsPanel_SegmentAudioChanged"
                                                AudioClipMutedChanged="EditToolsPanel_AudioClipMutedChanged"
                                                AudioClipGainCommitted="EditToolsPanel_AudioClipGainCommitted"
                                                AudioClipPanCommitted="EditToolsPanel_AudioClipPanCommitted"
                                                AudioClipFadesCommitted="EditToolsPanel_AudioClipFadesCommitted" />
                    </TabItem>
                </TabControl>
                    <jobs:GenerationJobsPanel x:Name="JobsPanelControl" Visibility="Collapsed" Margin="8"
                                              Closed="JobsPanelControl_Closed"
                                              CancelRequested="JobsPanelControl_CancelRequested"
                                              ErrorOccurred="JobsPanelControl_ErrorOccurred" />
                </Grid>
            </Border>

            <generation:ExpandedPromptEditor x:Name="ExpandedPromptEditorControl"
                                             Grid.Column="2" Grid.ColumnSpan="3" Panel.ZIndex="10"
                                             PromptChanged="ExpandedPromptEditor_PromptChanged"
                                             Closed="ExpandedPromptEditor_Closed" />
        </Grid>

        <Border Grid.Row="2" Background="#0B0D12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="9,0">
                <TextBlock x:Name="MediaToolsText" DockPanel.Dock="Right" Margin="24,0,0,0"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Style="{StaticResource ApplicationTextBlockStyle}" Text="Ready"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        </Grid>

        <Border x:Name="MediaDropOverlay" Panel.ZIndex="1000" Visibility="Collapsed"
                IsHitTestVisible="False" Background="#C90B0D12">
            <Border Width="430" Padding="42,34" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#F21A1E29" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="2" CornerRadius="10">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="70" Height="70" CornerRadius="35" Margin="0,0,0,18"
                            Background="#332FA8FF" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                        <TextBlock Text="+" Foreground="White" FontSize="48" FontWeight="Light"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-7,0,0" />
                    </Border>
                    <TextBlock Text="Import media" Foreground="White" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="MediaDropHintText" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center" Margin="0,9,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
