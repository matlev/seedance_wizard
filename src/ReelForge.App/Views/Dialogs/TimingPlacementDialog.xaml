<Window x:Class="ReelForge.App.Views.Dialogs.TimingPlacementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media timing warning" Width="590" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="⚠ Media timing warning" FontFamily="Segoe UI Symbol"
                       FontSize="19" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}"
                       Text="ReelForge couldn't fully verify this file's timing or media information. You can still use it, but some precise editing features may not work correctly until the file is repaired or replaced." />
            <TextBlock x:Name="VideoOnlyText" Visibility="Collapsed" Margin="0,10,0,0"
                       TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                       Text="The selected audio stream cannot be placed reliably. Continuing will place the video only." />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,15,0,18" Padding="10" CornerRadius="4"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#10131A">
            <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PrimaryButton" Content="Place Anyway" MinWidth="112" Padding="12,6"
                    Background="{StaticResource AccentBrush}" Foreground="White" Click="Place_Click" />
            <Button Content="Attempt Repair" MinWidth="112" Padding="12,6" Margin="8,0,0,0"
                    Click="Repair_Click" />
            <Button Content="Cancel" MinWidth="90" Padding="12,6" Margin="8,0,0,0"
                    IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
