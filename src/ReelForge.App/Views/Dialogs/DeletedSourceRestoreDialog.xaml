<Window x:Class="ReelForge.App.Views.Dialogs.DeletedSourceRestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore deleted source" Width="560" Height="380" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="RESTORE DELETED SOURCE" Style="{StaticResource ApplicationTextBlockStyle}" FontSize="16" />
        <TextBlock x:Name="DescriptionText" Grid.Row="1" Margin="0,6,0,12" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}" />
        <ListBox x:Name="MatchesList" Grid.Row="2" DisplayMemberPath="DisplayText" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button x:Name="ImportAsNewButton" Content="Import as new" Click="ImportAsNew_Click" />
            <Button Content="Restore selected" Background="{StaticResource AccentBrush}" Foreground="White"
                    IsDefault="True" Click="Restore_Click" />
        </StackPanel>
    </Grid>
</Window>
