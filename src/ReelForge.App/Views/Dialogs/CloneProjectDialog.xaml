<Window x:Class="ReelForge.App.Views.Dialogs.CloneProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clone ReelForge project"
        Width="760" Height="620" MinWidth="640" MinHeight="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="CLONE PROJECT" Style="{StaticResource ApplicationTextBlockStyle}" FontSize="17" Margin="0,0,0,5" />
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                   Text="Clone the saved project and its durable project files. ReelForge excludes rebuildable cache and recovery data." />

        <WrapPanel Grid.Row="2" Margin="0,16,0,8">
            <Button Content="Choose .rfp file…" Click="ChooseProjectFile_Click" />
        </WrapPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="Project to clone" Style="{StaticResource ApplicationTextBlockStyle}" Margin="0,0,0,5" />
            <ListBox x:Name="ProjectsList" Grid.Row="1" SelectionChanged="ProjectsList_SelectionChanged"
                     Background="#10131A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,6" ToolTip="{Binding ProjectFilePath}">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ApplicationTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ProjectFilePath}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="Clone name" Style="{StaticResource ApplicationTextBlockStyle}" Margin="0,0,0,4" />
            <TextBox x:Name="CloneNameTextBox" TextChanged="CloneSettingsChanged" />
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,10,0,0">
            <TextBlock Text="Clone location" Style="{StaticResource ApplicationTextBlockStyle}" Margin="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="CloneLocationTextBox" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Browse…" Click="BrowseCloneLocation_Click" Margin="7,0,0,0" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,12,0,0">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="10">
                <StackPanel>
                    <TextBlock Text="Clone folder" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    <TextBlock x:Name="CloneFolderPreviewText" Style="{StaticResource ApplicationTextBlockStyle}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="ValidationErrorText" TextWrapping="Wrap" Foreground="#FF9B9B" FontWeight="SemiBold" Margin="0,9,0,0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Confirm clone" Click="ConfirmClone_Click" IsDefault="True" Background="{StaticResource AccentBrush}" Foreground="White" Margin="10,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
