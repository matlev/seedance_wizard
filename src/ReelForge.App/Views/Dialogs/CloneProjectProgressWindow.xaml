<Window x:Class="ReelForge.App.Views.Dialogs.CloneProjectProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cloning ReelForge project"
        Width="560" Height="280" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="CLONING PROJECT" Style="{StaticResource ApplicationTextBlockStyle}" FontSize="17" />
        <TextBlock x:Name="PhaseText" Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource ApplicationTextBlockStyle}" Text="Preparing clone…" />
        <TextBlock x:Name="CurrentItemText" Grid.Row="2" Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
        <ProgressBar x:Name="CloneProgressBar" Grid.Row="3" Height="10" Margin="0,18,0,0" Minimum="0" Maximum="100" />
        <TextBlock x:Name="ProgressDetailText" Grid.Row="4" Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Style="{StaticResource DangerButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
