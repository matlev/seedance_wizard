<Window x:Class="ReelForge.App.Views.Dialogs.GenerationOutputSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose continuation source" Width="520" Height="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="CHOOSE SOURCE VIDEO" FontSize="18" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap"
                   Text="This generation produced multiple outputs. Choose the exact output whose boundary frame should drive the continuation." />
        <ListBox x:Name="OutputsList" Grid.Row="2" DisplayMemberPath="DisplayName" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Choose output" IsDefault="True" Click="Choose_Click"
                    Background="{StaticResource AccentBrush}" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
