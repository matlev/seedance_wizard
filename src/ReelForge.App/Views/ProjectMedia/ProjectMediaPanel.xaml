<UserControl x:Class="ReelForge.App.Views.ProjectMedia.ProjectMediaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="PROJECT MEDIA" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource MutedTextBrush}" Margin="4,2,4,8" />
        <ListBox x:Name="MediaList" Grid.Row="1" SelectionChanged="MediaList_SelectionChanged"
                 PreviewMouseRightButtonDown="MediaList_PreviewMouseRightButtonDown"
                 PreviewMouseLeftButtonDown="MediaList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="MediaList_PreviewMouseMove">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander Tag="{Binding Name}"
                                                  IsExpanded="True"
                                                  Loaded="GroupExpander_Loaded"
                                                  Expanded="GroupExpander_Expanded"
                                                  Collapsed="GroupExpander_Collapsed">
                                            <Expander.Template>
                                                <ControlTemplate TargetType="{x:Type Expander}">
                                                    <StackPanel>
                                                        <ToggleButton x:Name="HeaderToggle"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                      Background="Transparent"
                                                                      BorderThickness="0"
                                                                      Foreground="{DynamicResource MutedTextBrush}"
                                                                      Padding="5,10,4,4"
                                                                      Cursor="Hand"
                                                                      ToolTip="Show or hide this media group"
                                                                      AutomationProperties.Name="{Binding Name, StringFormat={}{0} media group}">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="{x:Type ToggleButton}">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                                <Border x:Name="HeaderBorder" Background="Transparent"
                                                                                        BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="18" />
                                                                                            <ColumnDefinition Width="*" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock x:Name="Chevron" Text="▾" FontSize="12"
                                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                                                                    </Grid>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="False">
                                                                                        <Setter TargetName="Chevron" Property="Text" Value="▸" />
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource PanelRaisedBrush}" />
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                        <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" />
                                                        </ToggleButton>
                                                        <ContentPresenter x:Name="ItemsHost" Content="{TemplateBinding Content}" />
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsExpanded" Value="False">
                                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Expander.Template>
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ContextMenu>
                <ContextMenu Opened="ContextMenu_Opened">
                    <MenuItem x:Name="RenameItem" Header="Change filename…" Tag="Rename" Click="Action_Click" />
                    <MenuItem Header="Export…" Tag="Export" Click="Action_Click" />
                    <MenuItem x:Name="ExtractAudioItem" Header="Extract audio…" Tag="ExtractAudio"
                              Click="Action_Click" />
                    <Separator />
                    <MenuItem x:Name="CopyToProjectItem" Header="Copy to Project…" Tag="Copy" Click="Action_Click" />
                    <MenuItem x:Name="MoveToProjectItem" Header="Move to Project…" Tag="Move" Click="Action_Click" />
                    <Separator />
                    <MenuItem Header="Delete from Project…" Tag="Delete" Foreground="#FF9B9B"
                              Click="Action_Click" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" Margin="1" CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="30" Background="#0B0D12"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="2" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="{Binding Glyph}" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="15" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding KindText}" FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
