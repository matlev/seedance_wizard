<UserControl x:Class="ReelForge.App.Views.ProjectMedia.ProjectMediaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="PROJECT MEDIA" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource MutedTextBrush}" Margin="4,2,4,8" />
        <ListBox x:Name="MediaList" Grid.Row="1" SelectionChanged="MediaList_SelectionChanged"
                 PreviewMouseRightButtonDown="MediaList_PreviewMouseRightButtonDown"
                 PreviewMouseLeftButtonDown="MediaList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="MediaList_PreviewMouseMove">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="5,10,4,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ContextMenu>
                <ContextMenu Opened="ContextMenu_Opened">
                    <MenuItem Header="Change filename…" Tag="Rename" Click="Action_Click" />
                    <MenuItem Header="Export…" Tag="Export" Click="Action_Click" />
                    <MenuItem x:Name="ExtractAudioItem" Header="Extract audio…" Tag="ExtractAudio"
                              Click="Action_Click" />
                    <Separator />
                    <MenuItem Header="Copy to Project…" Tag="Copy" Click="Action_Click" />
                    <MenuItem Header="Move to Project…" Tag="Move" Click="Action_Click" />
                    <Separator />
                    <MenuItem Header="Delete from Project…" Tag="Delete" Foreground="#FF9B9B"
                              Click="Action_Click" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" Margin="1" CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="30" Background="#0B0D12"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="2" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="{Binding Glyph}" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="15" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding KindText}" FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
