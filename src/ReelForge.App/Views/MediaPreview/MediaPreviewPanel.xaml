<UserControl x:Class="ReelForge.App.Views.MediaPreview.MediaPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Margin="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="5" Background="#050609">
            <Grid>
                <TextBlock x:Name="PreviewPlaceholder" Text="Select a video or image asset to preview"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <MediaElement x:Name="VideoPreview" Visibility="Collapsed"
                              LoadedBehavior="Manual" UnloadedBehavior="Stop"
                              ScrubbingEnabled="True" Volume="1" Stretch="Uniform"
                              MediaOpened="VideoPreview_MediaOpened"
                              MediaEnded="VideoPreview_MediaEnded" />
                <MediaElement x:Name="CompositionAuditionAudio" Width="1" Height="1" Opacity="0"
                              IsHitTestVisible="False" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                              Volume="1" MediaOpened="CompositionAuditionAudio_MediaOpened"
                              MediaFailed="CompositionAuditionAudio_MediaFailed" />
                <Image x:Name="ImagePreview" Visibility="Collapsed" Stretch="Uniform" />
            </Grid>
        </Border>
        <Border x:Name="PlaybackControlsBorder" VerticalAlignment="Bottom" Margin="22" Padding="8"
                CornerRadius="4" Background="#CC191C25" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlaybackButton" Grid.Column="0" Width="38" Height="32" Padding="5" Margin="0"
                        Click="PlaybackButton_Click" ToolTip="Play preview" IsEnabled="False"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Grid Width="19" Height="19">
                        <Path x:Name="PlayGlyph" Fill="{StaticResource TextBrush}"
                              Stretch="Uniform" Margin="2,1,1,1"
                              Data="M 1,0 L 16,8.5 L 1,17 Z" />
                        <Path x:Name="PauseGlyph" Fill="{StaticResource TextBrush}" Visibility="Collapsed"
                              Stretch="Uniform" Margin="2"
                              Data="M 1,0 H 6 V 17 H 1 Z M 11,0 H 16 V 17 H 11 Z" />
                    </Grid>
                </Button>
                <Button x:Name="PreviousFrameButton" Grid.Column="1" Width="32" Height="32"
                        Padding="4" Margin="5,0,0,0" Click="PreviousFrameButton_Click"
                        ToolTip="Rewind one decoded video frame" IsEnabled="False">
                    <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </Button>
                <Button x:Name="NextFrameButton" Grid.Column="2" Width="32" Height="32"
                        Padding="4" Margin="3,0,0,0" Click="NextFrameButton_Click"
                        ToolTip="Advance one decoded video frame" IsEnabled="False">
                    <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </Button>
                <Slider x:Name="PositionSlider" Grid.Column="3" Minimum="0" Maximum="1" Margin="10,0"
                        VerticalAlignment="Center" IsMoveToPointEnabled="False"
                        ValueChanged="PositionSlider_ValueChanged"
                        PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="PositionSlider_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp" />
                <TextBlock x:Name="TimeText" Grid.Column="4"
                           Style="{StaticResource ApplicationTextBlockStyle}"
                           Text="00:00 / 00:00" VerticalAlignment="Center" Margin="6,0,10,0" />
                <Button x:Name="MuteButton" Grid.Column="5" Content="Mute" Click="MuteButton_Click"
                        Padding="8,4" ToolTip="Mute or unmute preview audio" />
                <Slider x:Name="VolumeSlider" Grid.Column="6" Minimum="0" Maximum="1" Value="1"
                        SmallChange="0.05" LargeChange="0.1" Margin="6,0,2,0"
                        VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"
                        ToolTip="Preview volume" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
