<UserControl x:Class="ReelForge.App.Views.Generation.ExpandedPromptEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Width="31" Height="29" Padding="6" Margin="0"
                        ToolTip="Return to normal view" Click="Collapse_Click"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.5"
                          StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                          Data="M 1,6 L6,6 L6,1 M10,1 L10,6 L15,6 M15,10 L10,10 L10,15 M6,15 L6,10 L1,10" />
                </Button>
                <TextBlock Text="Prompt" Style="{StaticResource ApplicationTextBlockStyle}"
                           FontSize="18" VerticalAlignment="Center" />
            </DockPanel>
            <TextBox x:Name="PromptTextBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled" FontSize="14" Padding="12"
                     TextChanged="PromptTextBox_TextChanged"
                     PreviewKeyDown="PromptTextBox_PreviewKeyDown" />
        </Grid>
    </Border>
</UserControl>
