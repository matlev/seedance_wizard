<UserControl x:Class="ReelForge.App.Views.Generation.GenerationHistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:generation="clr-namespace:ReelForge.App.Views.Generation">
    <UserControl.Resources>
        <generation:PromptPreviewConverter x:Key="PromptPreviewConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="GENERATIONS" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource MutedTextBrush}" Margin="4,8,4,6" />
        <ListBox x:Name="GenerationsList" Grid.Row="1"
                 SelectionChanged="GenerationsList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 VerticalContentAlignment="Top">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="7,4">
                        <TextBlock Text="{Binding RequestSnapshot.Prompt, Converter={StaticResource PromptPreviewConverter}}"
                                   ToolTip="{Binding RequestSnapshot.Prompt}"
                                   Style="{StaticResource ApplicationTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Status}" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text=" / " FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding IngestionStatus}" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
