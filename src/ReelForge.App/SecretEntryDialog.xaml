<Window x:Class="ReelForge.App.SecretEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update credential" Height="230" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="22" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Style="{StaticResource ApplicationTextBlockStyle}" FontSize="16" />
        <TextBlock Grid.Row="1" Text="The existing value is never loaded. Enter the complete updated credential."
                   TextWrapping="Wrap" Margin="0,7,0,12" Foreground="{StaticResource MutedTextBrush}" />
        <PasswordBox x:Name="SecretPasswordBox" Grid.Row="2" />
        <TextBlock x:Name="ValidationText" Grid.Row="3" Margin="0,7,0,0" Foreground="#FF8A8A" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Update" Click="Update_Click"
                    Background="{StaticResource AccentBrush}" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
