<Window x:Class="ReelForge.App.FrameConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm continuation frame" Width="560" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Text="Confirm exact frame" FontSize="18" FontWeight="Bold" />
        <Border Grid.Row="1" Margin="0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Background="#050609">
            <Image x:Name="FrameImage" Stretch="Uniform" Margin="8" />
        </Border>
        <TextBlock x:Name="DetailsText" Grid.Row="2" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Use this frame" IsDefault="True" Click="Confirm_Click"
                    Background="{StaticResource AccentBrush}" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
