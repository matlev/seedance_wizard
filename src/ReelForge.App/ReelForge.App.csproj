<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- UI text intentionally follows the current culture; service fields remain interface-typed for substitution. -->
    <NoWarn>$(NoWarn);CA1305;CA1859</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReelForge.Core\ReelForge.Core.csproj" />
    <ProjectReference Include="..\ReelForge.Application\ReelForge.Application.csproj" />
    <ProjectReference Include="..\ReelForge.Infrastructure\ReelForge.Infrastructure.csproj" />
  </ItemGroup>

</Project>
