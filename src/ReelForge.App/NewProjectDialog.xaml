<Window x:Class="ReelForge.App.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create a ReelForge project"
        Width="640" Height="390" MinWidth="560"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="DialogActionButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,0,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform Y="-2" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ActionBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="22" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="NEW PROJECT" Style="{StaticResource ApplicationTextBlockStyle}"
                   FontSize="17" Margin="0,0,0,5" />
        <TextBlock Grid.Row="1"
                   Text="Each project gets its own named folder containing a project-named .rfp file and its media folders. The .rfp file is readable JSON."
                   TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,16" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="Project name" Style="{StaticResource ApplicationTextBlockStyle}" Margin="0,0,0,4" />
            <TextBox x:Name="ProjectNameTextBox" TextChanged="ProjectSettingsChanged"
                     ToolTip="This name is also used for the project's folder." />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Projects location" Style="{StaticResource ApplicationTextBlockStyle}" Margin="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ProjectsLocationTextBox" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Browse…" Click="BrowseProjectsLocation_Click" Margin="7,0,0,0" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Background="{StaticResource PanelBrush}" CornerRadius="4" Padding="10" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Project folder" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                <TextBlock x:Name="ProjectFolderPreviewText" Style="{StaticResource ApplicationTextBlockStyle}"
                           TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="ValidationErrorText" Grid.Row="5" TextWrapping="Wrap"
                   Foreground="#FF9B9B" FontWeight="SemiBold" Margin="0,10,0,0" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogActionButtonStyle}" />
            <Button Content="Create project" Click="CreateProject_Click" IsDefault="True"
                    Style="{StaticResource DialogActionButtonStyle}" Margin="10,0,0,0"
                    Background="{StaticResource AccentBrush}" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
