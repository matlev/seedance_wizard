<Window x:Class="SeedanceWizard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seedance Wizard" Height="900" Width="1440"
        MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,5">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="SEEDANCE WIZARD" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="4,0,18,0" />
                    <Button Content="New project" Click="NewProject_Click" />
                    <Button Content="Open" Click="OpenProject_Click" />
                    <Button Content="Save" Click="SaveProject_Click" />
                    <Button Content="Import assets" Click="ImportAssets_Click" />
                </StackPanel>
                <TextBlock x:Name="ProjectTitleText" Text="No project open" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="210" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="370" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="PROJECT ASSETS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="4,2,4,8" />
                    <ListBox x:Name="AssetsList" Grid.Row="1" SelectionChanged="AssetsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="1" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MediaType}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="GENERATIONS" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="4,12,4,6" />
                    <ListBox x:Name="GenerationsList" Grid.Row="3" SelectionChanged="GenerationsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="7,4">
                                    <TextBlock Text="{Binding Request.Prompt}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2" Background="#0B0D12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="280" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="230" MinHeight="120" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Border Margin="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Background="#050609">
                        <Grid>
                            <TextBlock x:Name="PreviewPlaceholder" Text="Select a video or image asset to preview"
                                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <MediaElement x:Name="VideoPreview" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                          Stretch="Uniform" MediaOpened="VideoPreview_MediaOpened" MediaEnded="VideoPreview_MediaEnded" />
                            <Image x:Name="ImagePreview" Visibility="Collapsed" Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <Border VerticalAlignment="Bottom" Margin="22" Padding="8" CornerRadius="4" Background="#CC191C25">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="Play" Click="Play_Click" Padding="10,4" />
                                <Button Content="Pause" Click="Pause_Click" Padding="10,4" />
                            </StackPanel>
                            <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Text="00:00 / 00:00" VerticalAlignment="Center" Margin="10,0" />
                            <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" Margin="10,0" VerticalAlignment="Center"
                                    PreviewMouseUp="PositionSlider_PreviewMouseUp" />
                        </DockPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" />

                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="TIMELINE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="Milestone 2" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
                        </DockPanel>
                        <Border Grid.Row="1" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="#11141B">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Non-destructive timeline editor" FontSize="15" HorizontalAlignment="Center" />
                                <TextBlock Text="Intentionally deferred until the project and media foundations are proven."
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" />

            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <TabControl Margin="8">
                    <TabItem Header="Inspector">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="MEDIA / PROVENANCE" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="2,4,2,8" />
                            <TextBox x:Name="InspectorText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Text="Select an asset or generation to inspect its metadata and provenance." />
                        </Grid>
                    </TabItem>
                    <TabItem Header="Generate">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12">
                                <TextBlock Text="FAKE PROVIDER" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock x:Name="ProviderText" TextWrapping="Wrap" Margin="0,4,0,14" />

                                <TextBlock Text="Prompt" Margin="0,0,0,4" />
                                <TextBox x:Name="PromptTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="120" />

                                <TextBlock Text="Mode" Margin="0,12,0,4" />
                                <ComboBox x:Name="ModeComboBox" />

                                <TextBlock Text="Duration" Margin="0,12,0,4" />
                                <DockPanel>
                                    <TextBlock x:Name="DurationText" DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                                    <Slider x:Name="DurationSlider" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="DurationSlider_ValueChanged" />
                                </DockPanel>

                                <TextBlock Text="Aspect ratio" Margin="0,12,0,4" />
                                <ComboBox x:Name="AspectRatioComboBox" />

                                <TextBlock Text="Resolution" Margin="0,12,0,4" />
                                <ComboBox x:Name="ResolutionComboBox" />

                                <TextBlock Text="Reference assets" Margin="0,12,0,4" />
                                <TextBlock Text="Use Ctrl/Shift to select multiple." FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                <ListBox x:Name="ReferenceAssetsList" Height="130" SelectionMode="Extended" Margin="0,4,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="5,3">
                                                <TextBlock Text="{Binding MediaType}" Foreground="{StaticResource MutedTextBrush}" Width="55" />
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button x:Name="GenerateButton" Content="Run fake generation" Click="Generate_Click"
                                        Background="{StaticResource AccentBrush}" Foreground="White" Margin="0,14,0,0" />
                                <TextBlock x:Name="GenerationStatusText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="3,8" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Tools">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12">
                                <TextBlock Text="FFMPEG TOOLS" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="Use PATH auto-detection or browse to each executable explicitly. Paths are saved per Windows user."
                                           TextWrapping="Wrap" Margin="0,4,0,14" Foreground="{StaticResource MutedTextBrush}" />

                                <TextBlock Text="FFmpeg executable" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FfmpegPathTextBox" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" Content="Browse…" Click="BrowseFfmpeg_Click" Margin="6,0,0,0" />
                                </Grid>

                                <TextBlock Text="ffprobe executable" Margin="0,12,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FfprobePathTextBox" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" Content="Browse…" Click="BrowseFfprobe_Click" Margin="6,0,0,0" />
                                </Grid>

                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Auto-detect from PATH" Click="AutoDetectTools_Click" Margin="0,0,7,0" />
                                    <Button Content="Save and apply" Click="SaveTools_Click" Background="{StaticResource AccentBrush}" Foreground="White" />
                                </WrapPanel>
                                <TextBlock x:Name="MediaToolSettingsStatusText" TextWrapping="Wrap" Margin="2,10,0,0"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0B0D12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="9,0">
                <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" />
                <TextBlock x:Name="MediaToolsText" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
