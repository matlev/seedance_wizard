<Application x:Class="SeedanceWizard.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#11131A" />
        <SolidColorBrush x:Key="PanelBrush" Color="#191C25" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#222633" />
        <SolidColorBrush x:Key="BorderBrush" Color="#343948" />
        <SolidColorBrush x:Key="TextBrush" Color="#F2F4F8" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#AAB1C0" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8C7CFF" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource WindowBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#10131A" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="7" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="Foreground" Value="#11131A" />
            <Setter Property="Padding" Value="5" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="#11131A" />
        </Style>
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        </Style>
    </Application.Resources>
</Application>
